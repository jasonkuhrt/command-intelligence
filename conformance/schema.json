{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Command Intelligence conformance suite",
  "type": "object",
  "required": ["binding", "cases"],
  "properties": {
    "binding": { "$ref": "#/$defs/binding" },
    "cases": { "type": "array", "minItems": 1, "items": { "oneOf": [
      { "$ref": "#/$defs/ranking" }, { "$ref": "#/$defs/flows" }, { "$ref": "#/$defs/flow_order" },
      { "$ref": "#/$defs/acceptance" }, { "$ref": "#/$defs/navigation" }
    ] } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "binding": {
      "type": "object", "required": ["timezone", "tokenizer", "context", "root_matching"],
      "properties": {
        "timezone": { "$ref": "#/$defs/id" },
        "tokenizer": {
          "type": "object", "required": ["separators", "escape", "offset_unit"],
          "properties": {
            "separators": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
            "escape": { "type": "string", "minLength": 1, "maxLength": 1 },
            "offset_unit": { "enum": ["utf8-byte", "utf16-unit", "unicode-scalar"] }
          }, "additionalProperties": false
        },
        "context": {
          "type": "object", "required": ["fixed", "resource_field", "empty_value", "exact", "facets"],
          "properties": {
            "fixed": { "type": "object", "additionalProperties": { "type": "string" } },
            "resource_field": { "$ref": "#/$defs/id" },
            "empty_value": { "$ref": "#/$defs/id" },
            "exact": { "$ref": "#/$defs/ids" },
            "facets": { "type": "array", "items": { "$ref": "#/$defs/ids" } }
          }, "additionalProperties": false
        },
        "root_matching": { "$ref": "#/$defs/id" }
      }, "additionalProperties": false
    },
    "context": {
      "type": "object", "required": ["project", "resource"],
      "properties": { "project": { "$ref": "#/$defs/id" }, "resource": { "$ref": "#/$defs/id" } },
      "additionalProperties": false
    },
    "step": {
      "type": "object", "required": ["capability"],
      "properties": { "capability": { "$ref": "#/$defs/id" }, "args": { "type": "object" } },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object", "required": ["id", "label"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string" } },
      "additionalProperties": false
    },
    "suggestion": {
      "type": "object", "required": ["id", "value"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "value": { "type": "string" } },
      "additionalProperties": false
    },
    "selections": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/id" } },
    "node": {
      "type": "object", "required": ["id", "token", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "token": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["namespace", "leaf", "hybrid", "slot"] },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "slot_kind": { "$ref": "#/$defs/id" },
        "required": { "type": "boolean" },
        "values": { "$ref": "#/$defs/ids" },
        "suggestions": { "type": "array", "items": { "$ref": "#/$defs/suggestion" } },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "slot" } } }, "then": { "required": ["slot_kind", "required"] } },
        { "if": { "properties": { "kind": { "not": { "const": "slot" } } } },
          "then": { "not": { "anyOf": [{ "required": ["slot_kind"] }, { "required": ["required"] }, { "required": ["values"] }, { "required": ["suggestions"] }, { "required": ["candidates"] }] } } },
        { "if": { "required": ["slot_kind"], "properties": { "slot_kind": { "const": "resource" } } },
          "then": { "required": ["candidates"], "properties": { "kind": { "const": "slot" } }, "not": { "anyOf": [{ "required": ["values"] }, { "required": ["suggestions"] }] } } },
        { "if": { "required": ["candidates"] },
          "then": { "required": ["slot_kind"], "properties": { "slot_kind": { "const": "resource" } } } }
      ], "additionalProperties": false
    },
    "tree": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "event": {
      "type": "object", "required": ["kind", "time", "context", "writer", "position"],
      "properties": {
        "kind": { "enum": ["commit", "resource_rename"] },
        "time": { "$ref": "#/$defs/timestamp" }, "context": { "$ref": "#/$defs/context" },
        "writer": { "$ref": "#/$defs/id" }, "position": { "type": "integer", "minimum": 1 },
        "surface": { "$ref": "#/$defs/id" }, "origin": { "enum": ["direct", "shortcut"] },
        "command_kind": { "enum": ["semantic", "native"] },
        "recorded_path": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "arguments_present": { "type": "boolean" }, "resource_selections": { "$ref": "#/$defs/selections" },
        "slot_id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "commit" } } },
          "then": { "required": ["surface", "origin", "command_kind", "recorded_path", "arguments_present", "resource_selections"], "not": { "anyOf": [{ "required": ["from"] }, { "required": ["to"] }, { "required": ["slot_id"] }] } } },
        { "if": { "properties": { "kind": { "const": "resource_rename" } } },
          "then": { "required": ["slot_id", "from", "to"], "not": { "anyOf": [{ "required": ["surface"] }, { "required": ["origin"] }, { "required": ["command_kind"] }, { "required": ["arguments_present"] }, { "required": ["recorded_path"] }, { "required": ["resource_selections"] }] } } },
        { "if": { "required": ["command_kind"], "properties": { "command_kind": { "const": "native" } } },
          "then": { "properties": { "recorded_path": { "maxItems": 1 }, "resource_selections": { "maxProperties": 0 } } } }
      ], "additionalProperties": false
    },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "query": {
      "type": "object", "required": ["time", "context", "parent", "current_writer", "text"],
      "properties": {
        "time": { "$ref": "#/$defs/timestamp" }, "context": { "$ref": "#/$defs/context" },
        "parent": { "type": ["string", "null"] }, "current_writer": { "$ref": "#/$defs/id" },
        "text": { "type": "string" },
        "matches": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "match_quality": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      },
      "allOf": [{ "if": { "properties": { "parent": { "type": "null" } } }, "then": { "not": { "required": ["matches"] } } }],
      "additionalProperties": false
    },
    "result_group": {
      "type": "object", "required": ["name", "ranked", "items"],
      "properties": { "name": { "$ref": "#/$defs/id" }, "ranked": { "type": "boolean" }, "items": { "$ref": "#/$defs/ids" } },
      "additionalProperties": false
    },
    "flow_query": {
      "type": "object", "required": ["time", "context", "current_writer"],
      "properties": {
        "time": { "$ref": "#/$defs/timestamp" }, "context": { "$ref": "#/$defs/context" },
        "current_writer": { "$ref": "#/$defs/id" }
      }, "additionalProperties": false
    },
    "ranking": {
      "type": "object", "required": ["id", "description", "type", "tree", "events", "query", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/id" },
        "type": { "const": "ranking" }, "tree": { "$ref": "#/$defs/tree" }, "recording_tree": { "$ref": "#/$defs/tree" },
        "events": { "$ref": "#/$defs/events" }, "query": { "$ref": "#/$defs/query" },
        "timezone": { "$ref": "#/$defs/id" },
        "expected": {
          "type": "object", "required": ["choices", "promotions"],
          "properties": { "choices": { "$ref": "#/$defs/ids" }, "promotions": { "$ref": "#/$defs/ids" }, "matches": { "type": "object", "additionalProperties": { "type": "boolean" } }, "groups": { "type": "array", "items": { "$ref": "#/$defs/result_group" } } },
          "additionalProperties": false
        }
      }, "additionalProperties": false
    },
    "flows": {
      "type": "object", "required": ["id", "description", "type", "tree", "events", "query", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/id" },
        "type": { "const": "flows" }, "tree": { "$ref": "#/$defs/tree" }, "recording_tree": { "$ref": "#/$defs/tree" },
        "events": { "$ref": "#/$defs/events" }, "query": { "$ref": "#/$defs/flow_query" },
        "timezone": { "$ref": "#/$defs/id" },
        "expected": {
          "type": "object", "required": ["proposals"],
          "properties": { "proposals": { "type": "array", "items": { "$ref": "#/$defs/proposal" } } }, "additionalProperties": false
        }
      }, "additionalProperties": false
    },
    "proposal": {
      "type": "object", "required": ["id", "project", "resource", "steps", "support", "score"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "project": { "$ref": "#/$defs/id" }, "resource": { "$ref": "#/$defs/id" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "support": { "type": "integer", "minimum": 1 }, "score": { "type": "integer", "minimum": 0 }
      }, "additionalProperties": false
    },
    "flow_order": {
      "type": "object", "required": ["id", "description", "type", "candidates", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/id" }, "type": { "const": "flow_order" },
        "candidates": { "type": "array", "items": {
          "type": "object", "required": ["project", "resource", "steps", "support", "score", "recency"],
          "properties": { "project": { "$ref": "#/$defs/id" }, "resource": { "$ref": "#/$defs/id" },
            "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }, "support": { "type": "integer", "minimum": 1 },
            "score": { "type": "integer", "minimum": 0 }, "recency": { "type": "integer", "minimum": 0 } },
          "additionalProperties": false
        } },
        "expected": { "type": "object", "required": ["proposals"], "properties": { "proposals": { "type": "array", "items": { "$ref": "#/$defs/proposal" } } }, "additionalProperties": false }
      }, "additionalProperties": false
    },
    "acceptance": {
      "type": "object", "required": ["id", "description", "type", "tree", "input", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/id" },
        "type": { "const": "acceptance" }, "tree": { "$ref": "#/$defs/tree" },
        "input": {
          "type": "object", "required": ["line", "cursor", "choice", "replace_root", "select_from_frontier"],
          "properties": {
            "line": { "type": "string" }, "cursor": { "type": "integer", "minimum": 0 },
            "choice": { "type": "string" }, "replace_root": { "type": "boolean" },
            "select_from_frontier": { "type": "boolean" }
          }, "additionalProperties": false
        },
        "expected": {
          "type": "object", "required": ["line", "cursor"],
          "properties": { "line": { "type": "string" }, "cursor": { "type": "integer", "minimum": 0 } },
          "additionalProperties": false
        }
      }, "additionalProperties": false
    },
    "navigation": {
      "type": "object", "required": ["id", "description", "type", "tree", "input", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/id" },
        "type": { "const": "navigation" }, "tree": { "$ref": "#/$defs/tree" },
        "input": {
          "type": "object", "required": ["current", "action", "selections", "ordinary_values"],
          "properties": {
            "current": { "$ref": "#/$defs/id" }, "choice": { "$ref": "#/$defs/id" },
            "action": { "enum": ["accept", "advance", "commit", "select", "back", "type_commit"] },
            "text": { "type": "string" }, "selections": { "$ref": "#/$defs/selections" }, "ordinary_values": { "$ref": "#/$defs/selections" }
          },
          "allOf": [{ "if": { "properties": { "action": { "enum": ["accept", "advance", "select"] } } }, "then": { "required": ["choice"] } }, { "if": { "properties": { "action": { "const": "type_commit" } } }, "then": { "required": ["text"] } }],
          "additionalProperties": false
        },
        "expected": {
          "type": "object", "required": ["current", "committed", "selections", "ordinary_values", "missing", "event_resources"],
          "properties": { "current": { "$ref": "#/$defs/id" }, "committed": { "type": "boolean" }, "selections": { "$ref": "#/$defs/selections" }, "ordinary_values": { "$ref": "#/$defs/selections" }, "missing": { "$ref": "#/$defs/ids" }, "event_resources": { "$ref": "#/$defs/selections" },
            "event": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["command_kind", "recorded_path", "arguments_present", "resource_selections"], "properties": { "command_kind": { "const": "semantic" }, "recorded_path": { "$ref": "#/$defs/ids" }, "arguments_present": { "type": "boolean" }, "resource_selections": { "$ref": "#/$defs/selections" } }, "additionalProperties": false }] } },
          "additionalProperties": false
        }
      }, "additionalProperties": false
    }
  }
}
