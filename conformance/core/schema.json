{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Command Intelligence core cases",
  "type": "object",
  "required": ["binding", "cases"],
  "properties": {
    "binding": {
      "type": "object", "required": ["time", "project", "context", "writer", "nodes", "resources", "tokenizer"],
      "properties": {
        "time": { "type": "string", "format": "date-time" }, "project": { "$ref": "#/$defs/id" },
        "context": { "type": "object", "additionalProperties": { "type": "string" } }, "writer": { "$ref": "#/$defs/id" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "resources": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/resource" } } },
        "tokenizer": { "type": "object", "required": ["separators", "escape", "offset_unit"], "properties": {
          "separators": { "type": "array", "items": { "type": "string" } }, "escape": { "type": "string" },
          "offset_unit": { "const": "utf8-byte" }
        }, "additionalProperties": false }
      }, "additionalProperties": false
    },
    "cases": { "type": "array", "minItems": 1, "items": { "oneOf": [
      { "$ref": "#/$defs/interaction" }, { "$ref": "#/$defs/edit" },
      { "$ref": "#/$defs/cutoff" }, { "$ref": "#/$defs/consistency" }
    ] } }
  }, "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "requires": { "type": "array", "uniqueItems": true, "items": { "enum": ["text_surface", "structured_surface", "resource_slots", "native_promotions", "flows"] } },
    "node": { "type": "object", "required": ["id", "kind", "parent"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["namespace", "action", "ordinary_slot", "resource_slot", "native", "flow"] },
      "parent": { "type": ["string", "null"] }, "required": { "type": "boolean" }, "safety": { "enum": ["safe", "destructive"] },
      "steps": { "$ref": "#/$defs/ids" }
    }, "additionalProperties": false },
    "resource": { "type": "object", "required": ["id", "label"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "label": { "type": "string" }
    }, "additionalProperties": false },
    "selections": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/id" } },
    "event": { "type": "object", "required": ["surface", "origin", "command_kind", "recorded_path", "arguments_present", "resource_selections"], "properties": {
      "surface": { "enum": ["text", "structured"] }, "origin": { "enum": ["direct", "shortcut"] },
      "command_kind": { "enum": ["semantic", "native"] }, "recorded_path": { "$ref": "#/$defs/ids" },
      "arguments_present": { "type": "boolean" }, "resource_selections": { "$ref": "#/$defs/selections" }
    }, "additionalProperties": false },
    "action": { "oneOf": [
      { "type": "object", "required": ["op", "path", "via"], "properties": { "op": { "const": "choose" }, "path": { "$ref": "#/$defs/ids" }, "via": { "enum": ["direct", "promotion"] } }, "additionalProperties": false },
      { "type": "object", "required": ["op", "path"], "properties": { "op": { "enum": ["change_path", "internal"] }, "path": { "$ref": "#/$defs/ids" } }, "additionalProperties": false },
      { "type": "object", "required": ["op", "slot", "id"], "properties": { "op": { "const": "pick_resource" }, "slot": { "$ref": "#/$defs/id" }, "id": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
      { "type": "object", "required": ["op", "slot", "text"], "properties": { "op": { "enum": ["type_resource", "ordinary_value"] }, "slot": { "$ref": "#/$defs/id" }, "text": { "type": "string" } }, "additionalProperties": false },
      { "type": "object", "required": ["op", "text"], "properties": { "op": { "const": "native_arguments" }, "text": { "type": "string" } }, "additionalProperties": false },
      { "type": "object", "required": ["op", "surface"], "properties": { "op": { "const": "commit" }, "surface": { "enum": ["text", "structured"] }, "available": { "type": "boolean" }, "confirmation": { "enum": ["accept", "decline"] }, "unavailable_step": { "$ref": "#/$defs/id" }, "declined_step": { "$ref": "#/$defs/id" }, "failed_step": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
      { "type": "object", "required": ["op"], "properties": { "op": { "const": "cancel" } }, "additionalProperties": false }
    ] },
    "interaction": { "type": "object", "required": ["id", "description", "type", "requires", "actions", "expected"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/id" }, "type": { "const": "interaction" },
      "requires": { "$ref": "#/$defs/requires" }, "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } },
      "expected": { "type": "object", "required": ["events", "executions"], "properties": {
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } }, "executions": { "$ref": "#/$defs/ids" },
        "status": { "type": "array", "items": { "enum": ["open", "refused", "closed"] } }, "forbidden_text": { "type": "array", "items": { "type": "string" } }
      }, "additionalProperties": false }
    }, "additionalProperties": false },
    "edit": { "type": "object", "required": ["id", "description", "type", "requires", "input", "expected"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/id" }, "type": { "const": "edit" }, "requires": { "$ref": "#/$defs/requires" },
      "input": { "type": "object", "required": ["line", "cursor", "operation", "text"], "properties": { "line": { "type": "string" }, "cursor": { "type": "integer", "minimum": 0 }, "operation": { "enum": ["type", "accept"] }, "text": { "type": "string" } }, "additionalProperties": false },
      "expected": { "type": "object", "required": ["line", "cursor"], "properties": { "line": { "type": "string" }, "cursor": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }
    }, "additionalProperties": false },
    "cutoff": { "type": "object", "required": ["id", "description", "type", "requires", "input", "expected"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/id" }, "type": { "const": "cutoff" }, "requires": { "$ref": "#/$defs/requires" },
      "input": { "type": "object", "required": ["now", "earlier"], "properties": { "now": { "type": "string", "format": "date-time" }, "earlier": { "type": "string", "format": "date-time" } }, "additionalProperties": false },
      "expected": { "type": "object", "required": ["at_cutoff_eligible", "before_cutoff_eligible", "earlier_eligible"], "properties": { "at_cutoff_eligible": { "const": true }, "before_cutoff_eligible": { "const": false }, "earlier_eligible": { "const": true } }, "additionalProperties": false }
    }, "additionalProperties": false },
    "consistency": { "type": "object", "required": ["id", "description", "type", "requires", "input", "expected"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/id" }, "type": { "const": "consistency" }, "requires": { "$ref": "#/$defs/requires" },
      "input": { "type": "object", "required": ["mode", "candidates", "history"], "properties": { "mode": { "enum": ["surfaces", "replay"] }, "candidates": { "$ref": "#/$defs/ids" }, "history": { "type": "array", "items": { "$ref": "#/$defs/event" } } }, "additionalProperties": false },
      "expected": { "type": "object", "required": ["same_order", "candidates"], "properties": { "same_order": { "const": true }, "candidates": { "$ref": "#/$defs/ids" } }, "additionalProperties": false }
    }, "additionalProperties": false }
  }
}
